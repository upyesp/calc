{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "calc",
  "version": "0.1.0",
  "identifier": "com.calc.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "cd ../web && trunk serve --port 8080",
    "beforeBuildCommand": "cd ../web && trunk build --release"
  },
  "app": {
    "windows": [
      {
        "title": "Calc",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
