{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "epher",
  "version": "0.4.1",
  "identifier": "com.epher.desktop",
  "mainBinaryName": "epher",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "cd ../web && trunk serve --port 8080",
    "beforeBuildCommand": "cd ../web && trunk build --release"
  },
  "app": {
    "windows": [
      {
        "title": "epher",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#1c1c1e",
        "additionalBrowserArgs": "--default-background-color=1c1c1e"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/man/man1/epher.1": "../../../packaging/man/epher.1"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/man/man1/epher.1": "../../../packaging/man/epher.1"
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./nsis-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
